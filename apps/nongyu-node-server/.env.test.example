# nongyu-node-server 测试环境（复制为 .env.test，勿提交真实口令）
# 必须指向本机独立测试库；禁止填远端 IP

PORT=3000
NODE_ENV=test

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=nongyu
MYSQL_PASSWORD=change-me
MYSQL_DATABASE=nongyu_test

JWT_SECRET=change-me-to-a-long-random-string-for-test
JWT_APP_TTL=60d
JWT_ADMIN_TTL=7d
BCRYPT_COST=10

SUPER_ADMIN_STUDENT_NO=202308596
SUPER_ADMIN_DEFAULT_PASSWORD=SuperAdminTestPass1

BUSINESS_TZ=Asia/Shanghai
INTERNAL_TOKEN=nongyu-test-internal-token
TRACK_BASE_URL=http://127.0.0.1:8082

LLM_POOL_ENABLED=true
LLM_KEY_ENCRYPTION_SECRET=test-llm-key-encryption-secret

# 反馈墙同步 GitHub Issue：测试环境留空即关闭，避免 vitest 触发外网调用
GITHUB_TOKEN=
GITHUB_REPO=
GITHUB_ISSUE_LABEL=feedback
GITHUB_ISSUE_TIMEOUT_MS=8000
